# Solana RPC Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_BACKUP_RPC_URL=

# Safety Spend Cap in SOL (Default: 0.05 SOL, Max allowed: 0.10 SOL)
SPEND_CAP_SOL=0.05

# Keypair path (ONLY required for --live mode; mount via volume in Docker)
# NEVER commit private key files to git repository!
SOLANA_KEYPAIR_PATH=/keys/id.json

# Execution Settings
BURST_SIZE=8
PORT=1995

